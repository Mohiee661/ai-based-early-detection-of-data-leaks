# Supabase dashboard -> Settings -> API
SUPABASE_URL=https://your-project.supabase.co
# Use the service_role key here (NOT anon) so the backend can bypass RLS
SUPABASE_KEY=eyJ...

# Free at https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Secret used for HMAC-SHA256 hashing of detected secrets and alert signatures
HMAC_SECRET_KEY=change-me-to-a-long-random-secret

# Encryption key for Fernet (AES-128-CBC + HMAC) snippet encryption
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If not provided, a random key will be generated on startup (do not use in production)
ENCRYPTION_KEY=
# Get at https://github.com/settings/tokens -> Generate new token (classic)
GITHUB_TOKEN=ghp_...

# Optional - email alerts for critical findings
# Example SMTP: smtp.gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=test4553397@gmail.com
# Use a Gmail App Password, not the normal account password
SMTP_PASSWORD=bdxn yqyz hnse ppvv
SMTP_USE_TLS=true
SMTP_USE_SSL=false
ALERT_EMAIL_FROM=test4553397@gmail.com
# Comma-separated list of recipients for critical finding alerts
ALERT_EMAIL_TO=mohithd472@gmail.com

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000
