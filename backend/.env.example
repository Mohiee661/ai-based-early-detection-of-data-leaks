# Supabase dashboard -> Settings -> API
SUPABASE_URL=https://your-project.supabase.co
# Use the service_role key here (NOT anon) so the backend can bypass RLS
SUPABASE_KEY=eyJ...

# Free at https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Optional - only needed if you hit GitHub rate limits
# Get at https://github.com/settings/tokens -> Generate new token (classic)
GITHUB_TOKEN=ghp_...

# Optional - email alerts for critical findings
# Example SMTP: smtp.gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
ALERT_EMAIL_FROM=
# Comma-separated list of recipients for critical finding alerts
ALERT_EMAIL_TO=

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000
