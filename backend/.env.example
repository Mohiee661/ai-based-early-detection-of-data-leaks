# Supabase dashboard -> Settings -> API
SUPABASE_URL=https://your-project.supabase.co
# Use the service_role key here (NOT anon) so the backend can bypass RLS
SUPABASE_KEY=eyJ...

# Free at https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Optional - only needed if you hit GitHub rate limits
# Get at https://github.com/settings/tokens -> Generate new token (classic)
GITHUB_TOKEN=ghp_...

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000
